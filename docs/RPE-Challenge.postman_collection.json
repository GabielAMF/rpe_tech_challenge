            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"code PRODUCT_ALREADY_ACTIVE\", () => pm.expect(pm.response.json().code).to.eql(\"PRODUCT_ALREADY_ACTIVE\"));"
                ]
