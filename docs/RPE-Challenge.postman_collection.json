    {
      "name": "5. Resilience (manual, see descriptions)",
      "item": [
        {
          "name": "6a-1 Create customer (card processor stopped)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{clientManagerUrl}}/api/v1/customers",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Joao\",\n    \"cpf\": \"{{resilienceCpf}}\",\n    \"birthDate\": \"1985-03-10\",\n    \"credit_info\": \"standard\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "First: `docker compose stop rpe-card-processor`."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('resilienceCpf', Array.from({length: 11}, () => Math.floor(Math.random() * 10)).join(''));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"resilienceCustomerId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "6a-2 Get customer -> cardInfoAvailable false",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{clientManagerUrl}}/api/v1/customers/{{resilienceCustomerId}}",
            "description": "Card processor still stopped: the customer is returned without the card."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"card unavailable, not hidden as 'no card'\", () => {",
                  "    pm.expect(b.card).to.be.null;",
                  "    pm.expect(b.cardInfoAvailable).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6a-3 Get customer after restart -> GOLD card",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{clientManagerUrl}}/api/v1/customers/{{resilienceCustomerId}}",
            "description": "`docker compose start rpe-card-processor`, wait ~25s: the message waited in the queue."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"GOLD card produced\", () => pm.expect(pm.response.json().card.product.name).to.eql(\"GOLD\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "6b-1 Create customer (LocalStack stopped) -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{clientManagerUrl}}/api/v1/customers",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Rita\",\n    \"cpf\": \"{{resilienceCpf}}\",\n    \"birthDate\": \"1992-07-01\",\n    \"credit_info\": \"standard\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "First: `docker compose stop localstack`. The event stays PENDING in the outbox."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('resilienceCpf', Array.from({length: 11}, () => Math.floor(Math.random() * 10)).join(''));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"resilienceCustomerId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "6b-2 Get customer after LocalStack is back -> card",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{clientManagerUrl}}/api/v1/customers/{{resilienceCustomerId}}",
            "description": "`docker compose up -d --force-recreate --wait localstack`, wait ~40s for the outbox relay."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"card produced\", () => pm.expect(pm.response.json().card.maskedNumber).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "6c Catalog stopped -> product snapshot",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{clientManagerUrl}}/api/v1/customers/{{customerId}}",
            "description": "Uses the PLATINUM customer from folder 3. First: `docker compose stop rpe-catalog` and `docker exec rpe-redis redis-cli del \"rpe-card-processor::catalog-products::9e5a2d7c-1b3f-4c8a-a6d4-7b9e1f3a5c2d\"`. Start the catalog again afterwards (`docker compose start rpe-catalog`)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json().card.product;",
                  "pm.test(\"PLATINUM from the card's snapshot, status null\", () => {",
                  "    pm.expect(p.name).to.eql(\"PLATINUM\");",
                  "    pm.expect(p.status).to.be.null;",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Not for the collection runner: each request needs a container stopped or started first, as its description says. The full steps (including the DLQ/redrive one, which needs `awslocal`) are in docs/TEST_PLAN.md, step 6."
    }
