    {
      "name": "3. Card issuance (Portador -> SQS -> Cartao -> Produto)",
      "item": [
        {
          "name": "Create customer with PLATINUM",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{clientManagerUrl}}/api/v1/customers",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Maria Silva\",\n    \"cpf\": \"{{cpf}}\",\n    \"birthDate\": \"1990-05-20\",\n    \"credit_info\": \"{{platinumProductId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('cpf', Array.from({length: 11}, () => Math.floor(Math.random() * 10)).join(''));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"ATIVO\", () => pm.expect(b.status).to.eql(\"ATIVO\"));",
                  "pm.collectionVariables.set(\"customerId\", b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get customer + card + product",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{clientManagerUrl}}/api/v1/customers/{{customerId}}",
            "description": "Waits `cardWaitMs` before sending. If the card is still null, send it again."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// the card is produced asynchronously (outbox -> SQS -> card processor)",
                  "setTimeout(() => {}, Number(pm.collectionVariables.get('cardWaitMs')));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"card service reachable\", () => pm.expect(b.cardInfoAvailable).to.be.true);",
                  "pm.test(\"card produced with a masked number\", () => {",
                  "    pm.expect(b.card).to.be.an(\"object\");",
                  "    pm.expect(b.card.maskedNumber).to.match(/^\\*{4} \\*{4} \\*{4} \\d{4}$/);",
                  "});",
                  "pm.test(\"product PLATINUM, ATIVO\", () => {",
                  "    pm.expect(b.card.product.name).to.eql(\"PLATINUM\");",
                  "    pm.expect(b.card.product.status).to.eql(\"ATIVO\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Card processor: card by customer",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{cardProcessorUrl}}/api/v1/customers/{{customerId}}/card",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"only the masked number leaves the service\", () => {",
                  "    pm.expect(b.maskedNumber).to.match(/^\\*{4} \\*{4} \\*{4} \\d{4}$/);",
                  "    pm.expect(b).to.not.have.any.keys(\"number\", \"cvv\", \"expiry\", \"holderName\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Card processor: no card -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{cardProcessorUrl}}/api/v1/customers/{{$guid}}/card",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"code CARD_NOT_FOUND\", () => pm.expect(pm.response.json().code).to.eql(\"CARD_NOT_FOUND\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Portador rules",
