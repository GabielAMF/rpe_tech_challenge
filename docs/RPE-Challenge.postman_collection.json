{
  "info": {
    "_postman_id": "e46a0bc5-6817-4a92-ad51-627a25edc7c2",
    "name": "RPEChallenge",
    "description": "End-to-end checks for rpe_catalog (8080), rpe_client_manager (8082) and rpe_card_processor (8083) running with `docker compose up --build -d --wait`.\n\nRun folders 0-4 in order with the collection runner: requests save ids and tokens into collection variables for the next ones, and every request has tests. Folder 5 is manual (containers must be stopped/started). Client manager requests use the bearer token saved by \"Login admin\".",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Catalog health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{catalogUrl}}/actuator/health",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Client manager health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{clientManagerUrl}}/actuator/health",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Card processor health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{cardProcessorUrl}}/actuator/health",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        }
      ],
      "description": "All three services must be UP (`docker compose up --build -d --wait`)."
    },
    {
      "name": "1. Authentication (Portador)",
      "item": [
        {
          "name": "Request without token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{clientManagerUrl}}/api/v1/customers/{{goldProductId}}",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"code UNAUTHORIZED\", () => pm.expect(pm.response.json().code).to.eql(\"UNAUTHORIZED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login wrong password -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{clientManagerUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"wrong-pass\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"code INVALID_CREDENTIALS\", () => pm.expect(pm.response.json().code).to.eql(\"INVALID_CREDENTIALS\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin (saves token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{clientManagerUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"returns a bearer token\", () => pm.expect(body.accessToken).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"token\", body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create USER (as admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{clientManagerUrl}}/api/v1/auth/users",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{testUsername}}\",\n    \"password\": \"tester12345\",\n    \"role\": \"USER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('testUsername', 'tester' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"role USER, no password\", () => {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b.role).to.eql(\"USER\");",
                  "    pm.expect(b).to.not.have.property(\"password\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login USER (saves userToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{clientManagerUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{testUsername}}\",\n    \"password\": \"tester12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"userToken\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "USER creates a user -> 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{clientManagerUrl}}/api/v1/auth/users",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"x2\",\n    \"password\": \"x2345678\",\n    \"role\": \"USER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"code FORBIDDEN\", () => pm.expect(pm.response.json().code).to.eql(\"FORBIDDEN\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Produto Service (Catalog)",
      "item": [
        {
          "name": "Get seeded GOLD",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{catalogUrl}}/api/v1/products/{{goldProductId}}",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"GOLD, ATIVO, audit fields\", () => {",
                  "    pm.expect(b.name).to.eql(\"GOLD\");",
                  "    pm.expect(b.status).to.eql(\"ATIVO\");",
                  "    pm.expect(b.createdAt).to.be.a(\"string\");",
                  "    pm.expect(b.updatedAt).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product (name normalized)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{catalogUrl}}/api/v1/products",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"  {{productName}}  \",\n    \"description\": \"QA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('productName', 'test card ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"name trimmed and upper-cased\", () => pm.expect(b.name).to.eql(pm.collectionVariables.get(\"productName\").toUpperCase()));",
                  "pm.test(\"ATIVO\", () => pm.expect(b.status).to.eql(\"ATIVO\"));",
                  "pm.collectionVariables.set(\"productId\", b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create duplicate name -> 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{catalogUrl}}/api/v1/products",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"{{productName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"code PRODUCT_NAME_ALREADY_EXISTS\", () => pm.expect(pm.response.json().code).to.eql(\"PRODUCT_NAME_ALREADY_EXISTS\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{catalogUrl}}/api/v1/products/{{productId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"{{productName}}\",\n    \"description\": \"changed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"description changed\", () => pm.expect(pm.response.json().description).to.eql(\"changed\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel product -> 204",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{catalogUrl}}/api/v1/products/{{productId}}",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel again -> 204 (idempotent)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{catalogUrl}}/api/v1/products/{{productId}}",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get cancelled product",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{catalogUrl}}/api/v1/products/{{productId}}",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"CANCELADO\", () => pm.expect(pm.response.json().status).to.eql(\"CANCELADO\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create with cancelled name -> 409 + productId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{catalogUrl}}/api/v1/products",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"{{productName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"code CANCELLED_PRODUCT_EXISTS\", () => pm.expect(pm.response.json().code).to.eql(\"CANCELLED_PRODUCT_EXISTS\"));",
                  "pm.test(\"points to the cancelled product\", () => pm.expect(pm.response.json().productId).to.eql(pm.collectionVariables.get(\"productId\")));"
                ]
              }
